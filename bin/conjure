#!/usr/bin/env bash
#
# conjure — natural-language → Unix command, via the Anthropic Messages API.
#
# Usage:
#   conjure "<description>"        Generate a command (fast, ~0.85s)
#   conjure -e "<description>"     Generate command + brief explanation (~1.3s)
#   conjure --no-explain "..."     Force plain output (overrides CONJURE_EXPLAIN)
#   conjure --setup                Store API key in macOS Keychain (one-time)
#   conjure --version              Print version
#   conjure --help                 Show this help
#
# With --explain, output is two lines: command, then a `# explanation` comment.
#
# Environment overrides:
#   CONJURE_MODEL        Anthropic model id        (default: claude-haiku-4-5)
#   CONJURE_MAX_TOKENS   Max output tokens         (default: 256)
#   CONJURE_OS           OS hint for the prompt    (default: auto-detected)
#   CONJURE_EXPLAIN      Default to --explain      (set to 1; override per-call)
#

set -uo pipefail

CONJURE_VERSION="0.1.0"
KEYCHAIN_SERVICE="anthropic-api-key"

usage() {
  sed -n '3,21p' "$0" | sed 's/^# \{0,1\}//'
}

err() { printf '%s\n' "$*" >&2; }

# --- Dependency checks -------------------------------------------------------

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    err "conjure: '$1' is required but not installed."
    [ -n "${2:-}" ] && err "  Install with: $2"
    exit 127
  fi
}

# --- Keychain helpers (macOS) ------------------------------------------------

keychain_get() {
  security find-generic-password -a "$USER" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null
}

keychain_set() {
  security add-generic-password -a "$USER" -s "$KEYCHAIN_SERVICE" -w "$1" -U
}

# --- System prompt + heuristic check ----------------------------------------

# Build an OS-aware system prompt with concrete GNU↔BSD examples.
# Sent with cache_control: ephemeral (5min) so we pay for it once per window.
build_system_prompt() {
  local os=$1
  case "$os" in
    Darwin)
      cat <<'EOF'
You translate natural-language descriptions into single-line Unix commands.
Target system: macOS (Darwin) with zsh and BSD coreutils.

CRITICAL RULES:
1. Output exactly ONE command line. No markdown fences. No explanation prose.
2. Prefer BSD/POSIX syntax. NEVER use GNU-only flags. NEVER use:
   --color=auto, find -printf, date -d, stat -c, sed -i 'PATTERN' (without ''),
   xargs -d, ls --quoting-style, --files0-from, readlink -f.
3. Use idiomatic macOS commands: ls -G, sed -i '' 'PATTERN', stat -f, date -v.
4. Prefer `-exec ... {} +` over `-exec ... \;` for performance.
5. Quote arguments that may contain spaces, globs, or special chars.

GNU-bad → BSD-good examples:
  find . -printf '%s %f\n'         →  find . -exec stat -f '%z %N' {} +
  sed -i 's/a/b/' file             →  sed -i '' 's/a/b/' file
  date -d "1 day ago" +%Y-%m-%d    →  date -v-1d +%Y-%m-%d
  stat -c '%s' file                →  stat -f '%z' file
  ls --color=auto                  →  ls -G
  readlink -f path                 →  realpath path     (or: cd path && pwd)
  find . -type f | xargs -d '\n'   →  find . -type f -print0 | xargs -0
EOF
      ;;
    Linux)
      cat <<'EOF'
You translate natural-language descriptions into single-line Unix commands.
Target system: Linux with bash and GNU coreutils.

CRITICAL RULES:
1. Output exactly ONE command line. No markdown fences. No explanation prose.
2. Use idiomatic GNU syntax: stat -c, date -d, sed -i 'PATTERN' (no empty arg),
   find -printf, readlink -f, xargs -d.
3. Prefer `-exec ... {} +` over `-exec ... \;` for performance.
4. Quote arguments that may contain spaces, globs, or special chars.
EOF
      ;;
    *)
      cat <<EOF
You translate natural-language descriptions into single-line POSIX shell commands
for $os. Output exactly ONE command line. No markdown. Prefer POSIX-portable syntax.
EOF
      ;;
  esac
}

# Print warnings to stderr if the command contains known GNU-only patterns
# while we're targeting macOS. Non-fatal — just a hint.
check_gnu_isms() {
  local cmd=$1 os=$2
  [ "$os" = "Darwin" ] || return 0

  local hits=""
  case "$cmd" in
    *"find "*"-printf"*)        hits="$hits\n  - 'find -printf' is GNU-only; use 'find -exec stat -f ... {} +'" ;;
  esac
  case "$cmd" in
    *"--color=auto"*)           hits="$hits\n  - '--color=auto' is GNU-only on macOS; ls accepts -G instead" ;;
  esac
  case "$cmd" in
    *"stat -c"*)                hits="$hits\n  - 'stat -c' is GNU-only; macOS uses 'stat -f'" ;;
  esac
  case "$cmd" in
    *"date -d "*)               hits="$hits\n  - 'date -d' is GNU-only; macOS uses 'date -v' (e.g. 'date -v-1d')" ;;
  esac
  case "$cmd" in
    *"readlink -f"*)            hits="$hits\n  - 'readlink -f' is GNU-only; use 'realpath' or 'cd ... && pwd'" ;;
  esac
  # sed -i without empty '' arg right after — heuristic, may have false positives
  case "$cmd" in
    *"sed -i '"*)
      case "$cmd" in
        *"sed -i ''"*) ;;
        *) hits="$hits\n  - 'sed -i' on macOS needs an empty backup arg: sed -i '' 'PATTERN'" ;;
      esac
      ;;
  esac

  if [ -n "$hits" ]; then
    err "conjure: heuristic warning — possible GNU syntax in command:"
    printf '%b\n' "$hits" >&2
  fi
}

# --- Subcommands -------------------------------------------------------------

cmd_setup() {
  require_cmd security "macOS only — 'security' is not available."
  if existing=$(keychain_get) && [ -n "$existing" ]; then
    printf 'A key is already stored. Overwrite? [y/N] '
    read -r ans
    case "$ans" in
      y|Y) ;;
      *) printf 'Aborted.\n'; return 0 ;;
    esac
  fi
  printf 'Anthropic API key (hidden, get one at https://console.anthropic.com/settings/keys): '
  stty -echo
  read -r key
  stty echo
  printf '\n'
  if [ -z "$key" ]; then
    err "conjure: empty input, nothing stored."
    return 1
  fi
  if keychain_set "$key"; then
    printf '\xE2\x9C\x93 API key stored in Keychain (service=%s).\n' "$KEYCHAIN_SERVICE"
  else
    err "conjure: failed to write Keychain entry."
    return 1
  fi
  unset key
}

cmd_generate() {
  local explain=$1; shift

  require_cmd jq "brew install jq"
  require_cmd curl
  require_cmd security "macOS only — 'security' is not available."

  local key
  key=$(keychain_get) || true
  if [ -z "$key" ]; then
    err "conjure: API key not found in Keychain. Run: conjure --setup"
    return 1
  fi

  local model="${CONJURE_MODEL:-claude-haiku-4-5}"
  local max_tokens="${CONJURE_MAX_TOKENS:-256}"
  local os_hint="${CONJURE_OS:-$(uname -s)}"

  # System prompt is OS-specific. We tag it with cache_control: ephemeral (5min)
  # so it caches automatically when eligible — Anthropic only caches blocks at
  # or above ~1024 tokens (Sonnet/Opus) / ~2048 tokens (Haiku). Our prompt is
  # ~350 tokens, so the cache_control is a no-op on Haiku today, but starts
  # working free-of-charge if you switch to Sonnet via CONJURE_MODEL or grow
  # the prompt. See: https://docs.anthropic.com/en/docs/build-with-claude/prompt-caching
  local system_text
  system_text=$(build_system_prompt "$os_hint")

  local body prompt
  if [ "$explain" = "1" ]; then
    # Tool-use mode: model must call emit_command with structured args.
    prompt="Task: $*"
    local tool_schema
    tool_schema=$(jq -nc \
      '{
        name: "emit_command",
        description: "Emit the generated Unix command and a brief explanation",
        input_schema: {
          type: "object",
          properties: {
            command: {type: "string", description: "Single-line Unix command, no markdown fences, no surrounding whitespace"},
            explanation: {type: "string", description: "Brief one-sentence explanation of what the command does"}
          },
          required: ["command", "explanation"]
        }
      }')
    body=$(jq -nc \
      --arg model "$model" \
      --arg prompt "$prompt" \
      --arg system "$system_text" \
      --argjson max_tokens "$max_tokens" \
      --argjson tool "$tool_schema" \
      '{model: $model, max_tokens: $max_tokens,
        system: [{type: "text", text: $system, cache_control: {type: "ephemeral"}}],
        messages: [{role: "user", content: $prompt}],
        tools: [$tool],
        tool_choice: {type: "tool", name: "emit_command"}}')
  else
    # Plain-text mode: model returns just the command line.
    prompt="Task: $*"
    body=$(jq -nc \
      --arg model "$model" \
      --arg prompt "$prompt" \
      --arg system "$system_text" \
      --argjson max_tokens "$max_tokens" \
      '{model: $model, max_tokens: $max_tokens,
        system: [{type: "text", text: $system, cache_control: {type: "ephemeral"}}],
        messages: [{role: "user", content: $prompt}]}')
  fi

  local response
  response=$(curl -sS https://api.anthropic.com/v1/messages \
    -H "x-api-key: $key" \
    -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d "$body")
  local curl_status=$?
  if [ $curl_status -ne 0 ]; then
    err "conjure: API call failed (curl exit $curl_status)"
    return 1
  fi

  local api_err
  api_err=$(printf '%s' "$response" | jq -r '.error.message // empty')
  if [ -n "$api_err" ]; then
    err "conjure: API error: $api_err"
    return 1
  fi

  if [ "$explain" = "1" ]; then
    local input cmd explanation
    input=$(printf '%s' "$response" | jq -c '.content[] | select(.type == "tool_use") | .input' | head -1)
    if [ -z "$input" ]; then
      err "conjure: no tool_use in response"
      err "raw: $response"
      return 1
    fi
    cmd=$(printf '%s' "$input" | jq -r '.command // empty')
    explanation=$(printf '%s' "$input" | jq -r '.explanation // empty')
    if [ -z "$cmd" ]; then
      err "conjure: tool_use returned empty command"
      err "raw: $input"
      return 1
    fi
    check_gnu_isms "$cmd" "$os_hint"
    printf '%s\n' "$cmd"
    [ -n "$explanation" ] && printf '# %s\n' "$explanation"
    return 0
  fi

  local cmd
  cmd=$(printf '%s' "$response" | jq -r '.content[0].text // empty')
  if [ -z "$cmd" ]; then
    err "conjure: empty response"
    err "raw: $response"
    return 1
  fi

  # Strip markdown fences and surrounding whitespace
  cmd=$(printf '%s' "$cmd" \
    | sed -E '1s/^```[a-zA-Z0-9_-]*$//' \
    | sed -E '$s/^```$//' \
    | sed -E 's/^`(.*)`$/\1/' \
    | awk 'NF{print; exit}')

  check_gnu_isms "$cmd" "$os_hint"
  printf '%s\n' "$cmd"
}

# --- Main --------------------------------------------------------------------

main() {
  if [ $# -eq 0 ]; then
    usage
    return 1
  fi

  # Subcommand-style flags consume the whole invocation.
  case "$1" in
    -h|--help)    usage; return 0 ;;
    -v|--version) printf 'conjure %s\n' "$CONJURE_VERSION"; return 0 ;;
    --setup)      cmd_setup; return $? ;;
  esac

  # Generation flags. Env-var sets the default; flags override per-call.
  local explain="${CONJURE_EXPLAIN:-0}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -e|--explain)    explain=1; shift ;;
      --no-explain)    explain=0; shift ;;
      --)              shift; break ;;
      --*|-?)          err "conjure: unknown flag '$1'"; usage; return 1 ;;
      *)               break ;;
    esac
  done

  if [ $# -eq 0 ]; then
    err "conjure: missing description"
    usage
    return 1
  fi

  cmd_generate "$explain" "$@"
}

main "$@"
