# conjure — fish integration
# Generated by `conjure shell-init fish`. Source from ~/.config/fish/config.fish:
#     conjure shell-init fish | source

if not type -q conjure
    echo "conjure: 'conjure' not found on PATH." >&2
    exit 1
end

function cj
    set -l output (conjure $argv)
    or return $status
    test -z "$output"; and return 0
    set -l lines (string split \n -- $output)
    set -l cmd $lines[1]
    set -l rest $lines[2..-1]
    test -n "$rest"; and printf '%s\n' $rest
    test -n "$cmd"; and commandline -r -- $cmd
end
