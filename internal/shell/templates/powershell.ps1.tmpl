# conjure — PowerShell integration
# Generated by `conjure shell-init powershell`. Add to your $PROFILE:
#     conjure shell-init powershell | Out-String | Invoke-Expression

if (-not (Get-Command conjure -ErrorAction SilentlyContinue)) {
    Write-Error "conjure: 'conjure' not found on PATH."
    return
}

function cj {
    [CmdletBinding()] param([Parameter(ValueFromRemainingArguments)] $args)
    $output = conjure @args
    if (-not $output) { return }
    $lines = $output -split "`n"
    $cmd  = $lines[0]
    $rest = $lines[1..($lines.Length-1)] -join "`n"
    if ($rest) { Write-Host $rest }
    if ($cmd) {
        if (Get-Module PSReadLine -ErrorAction SilentlyContinue) {
            [Microsoft.PowerShell.PSConsoleReadLine]::Insert($cmd)
        } else {
            Write-Host $cmd
        }
    }
}
