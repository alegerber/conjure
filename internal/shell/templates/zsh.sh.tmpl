# conjure — zsh integration
# Generated by `conjure shell-init zsh`. Source this from your ~/.zshrc:
#     eval "$(conjure shell-init zsh)"
# Or save to a file and source it.

if (( ! $+commands[conjure] )); then
  print -u2 "conjure: 'conjure' not found on PATH."
  return 1
fi

cj() {
  case "$1" in
    setup|--version|-v|--help|-h) conjure "$@"; return $? ;;
  esac
  local output cmd rest
  output=$(conjure "$@") || return $?
  [[ -z "$output" ]] && return 0
  cmd=${output%%$'\n'*}
  if [[ "$output" == *$'\n'* ]]; then
    rest=${output#*$'\n'}
    rest=${rest%$'\n'}
  fi
  [[ -n "$rest" ]] && print -r -- "$rest"
  [[ -n "$cmd" ]] && print -z -- "$cmd"
}

_conjure() {
  _arguments '*::description:'
}
compdef _conjure conjure cj 2>/dev/null
