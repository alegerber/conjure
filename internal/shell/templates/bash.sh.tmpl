# conjure — bash integration
# Generated by `conjure shell-init bash`. Source from ~/.bashrc:
#     eval "$(conjure shell-init bash)"

if ! command -v conjure >/dev/null 2>&1; then
  echo "conjure: 'conjure' not found on PATH." >&2
  return 1 2>/dev/null || exit 1
fi

cj() {
  local output cmd rest
  output=$(conjure "$@") || return $?
  [[ -z "$output" ]] && return 0
  cmd=${output%%$'\n'*}
  if [[ "$output" == *$'\n'* ]]; then
    rest=${output#*$'\n'}
    rest=${rest%$'\n'}
  fi
  [[ -n "$rest" ]] && printf '%s\n' "$rest"
  # Push command into Readline buffer (interactive shells only).
  if [[ $- == *i* ]]; then
    READLINE_LINE="$cmd"
    READLINE_POINT=${#cmd}
  else
    printf '%s\n' "$cmd"
  fi
}

# Optional: bind Ctrl-X Ctrl-J to prompt for a description, then run cj.
__conjure_prompt() {
  local desc
  read -e -p "conjure> " desc || return
  [[ -z "$desc" ]] && return
  cj "$desc"
}
bind -x '"\C-x\C-j": __conjure_prompt' 2>/dev/null
